# Copiar a .env.local y rellenar con los valores del proyecto Supabase.
# NUNCA commitear valores reales: el repositorio es público (Principio II de la constitución).

# URL del proyecto Supabase. Pública, expuesta al cliente.
NEXT_PUBLIC_SUPABASE_URL=

# Llave anónima de Supabase. Pública por diseño; el acceso lo restringe RLS, no el secreto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave de rol de servicio. SOLO SERVIDOR.
# Sin prefijo NEXT_PUBLIC_ a propósito: si aparece en el bundle del cliente, es un incidente
# y hay que rotar la llave. Se usa exclusivamente desde lib/supabase/server.ts.
SUPABASE_SERVICE_ROLE_KEY=
